---
import "@fontsource-variable/schibsted-grotesk";
import { links, projects, site } from "../data/site";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={site.description} />
		<meta name="color-scheme" content="light" />
		<title>{site.name}</title>
	</head>
	<body>
		<main>
			<header class="reveal" style="--i: 0">
				<h1>{site.name}</h1>
				<p class="muted">{site.role}</p>
			</header>

			<p class="muted reveal" style="--i: 1">{site.bio}</p>

			<section class="reveal" style="--i: 2" aria-labelledby="projects">
				<h2 id="projects">Projects</h2>
				<ul class="list">
					{
						projects.map((project) => (
							<li>
								{project.href ? (
									<a class="row" href={project.href}>
										<span class="title">{project.name}</span>
										<span class="muted">{project.description}</span>
									</a>
								) : (
									<div class="row">
										<span class="title">
											{project.name}
											<span class="soon">Soon</span>
										</span>
										<span class="muted">{project.description}</span>
									</div>
								)}
							</li>
						))
					}
				</ul>
			</section>

			<footer class="reveal" style="--i: 3">
				<h2>More</h2>
				<p class="muted">
					Find me on{" "}
					{
						links.map((link, index) => (
							<>
								{index > 0 && (index === links.length - 1 ? " and " : ", ")}
								<a class="inline" href={link.href}>
									{link.label}
								</a>
							</>
						))
					}.
				</p>
			</footer>
		</main>
	</body>
</html>

<style is:global>
	:root {
		--bg: #fff;
		--text: #111;
		--muted: #6b6b6b;
		--line: #e5e5e5;
		--accent: #111;
		--hover: #f5f5f5;
		color-scheme: light;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		-webkit-text-size-adjust: 100%;
	}

	body {
		background: var(--bg);
		color: var(--text);
		font-family: "Schibsted Grotesk Variable", ui-sans-serif, system-ui, sans-serif;
		font-size: 16px;
		line-height: 1.65;
		-webkit-font-smoothing: antialiased;
	}

	::selection {
		background: var(--line);
		color: var(--text);
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
		border-radius: 4px;
	}
</style>

<style>
	main {
		display: flex;
		flex-direction: column;
		gap: 56px;
		max-width: 584px;
		margin: 0 auto;
		padding: 96px 24px 80px;
	}

	h1,
	h2 {
		font-size: inherit;
		font-weight: 500;
	}

	h2 {
		margin-bottom: 12px;
	}

	.muted {
		color: var(--muted);
	}

	.list {
		display: flex;
		flex-direction: column;
		gap: 4px;
		margin-inline: -12px;
		list-style: none;
	}

	.row {
		display: flex;
		flex-direction: column;
		padding: 8px 12px;
		border-radius: 8px;
		color: inherit;
		text-decoration: none;
	}

	a.row {
		transition: background-color 150ms ease;
	}

	.title {
		display: flex;
		align-items: center;
		gap: 8px;
		font-weight: 500;
	}

	.soon {
		color: var(--muted);
		font-size: 12px;
		font-weight: 400;
	}

	.inline {
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: var(--line);
		text-underline-offset: 3px;
		transition: text-decoration-color 150ms ease;
	}

	@media (hover: hover) {
		a.row:hover {
			background: var(--hover);
		}

		.inline:hover {
			text-decoration-color: var(--accent);
		}
	}

	.reveal {
		animation: reveal 500ms cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: calc(var(--i) * 70ms);
	}

	@keyframes reveal {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal {
			animation: none;
		}
	}

	@media (max-width: 480px) {
		main {
			gap: 48px;
			padding: 64px 16px 64px;
		}

		.list {
			margin-inline: -8px;
		}

		.row {
			padding-inline: 8px;
		}
	}
</style>
